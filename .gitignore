# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example

# Morpher runtime / generated data
storage/input/*
storage/processed/*
storage/figma-import/*
storage/fonts/*
storage/font-registry.json
storage/log/*
storage/output/*

# Keep storage directories if placeholder files are used
!storage/**/.gitkeep

# WordPress / Docker local runtime
wordpress/
wp-data/
mysql/
mysql-data/
db-data/

# Morpher WordPress plugin runtime font assets
wp-content/plugins/morpher-plugin/assets/fonts.css
wp-content/plugins/morpher-plugin/assets/fonts.json
wp-content/plugins/morpher-plugin/assets/fonts/*
!wp-content/plugins/morpher-plugin/assets/fonts/.gitkeep

# Morpher WordPress deployment staging/runtime state
wp-content/plugins/morpher-plugin/deployments/*
!wp-content/plugins/morpher-plugin/deployments/.gitkeep

# Local Elementor fidelity fixtures
# Font binaries stay local; Morpher only mounts them into the testbed.
testbed/fonts/*.woff
testbed/fonts/*.woff2
testbed/fonts/*.eot
testbed/fonts/*.ttf
testbed/fonts/*.otf

# Logs / temp
*.log
*.tmp
*.bak
